{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "./src",                          /* Specify the root folder of input files */
    "outDir": "./dist",                          /* Redirect output structure to the directory */
    "noImplicitAny": true,                       /* Raise error on expressions and declarations with an implied 'any' type */
    "strictNullChecks": true,                    /* Enable strict null checks */
    // "typeRoots": [], 
  /* Interop Constraints */
    "esModuleInterop": true,                     /* Enables emit interoperability between CommonJS and ES Modules */
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
 
  "include": ["src/**/*", "src/types/express/index.d.ts"],                       /* Compile all files within the src directory */
  "exclude": ["node_modules", "dist"]            /* Exclude these directories from compilation */
}